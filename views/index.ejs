<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="main w-full min-h-screen bg-zinc-900">
        <div class="form p-10 text-white"> 
            <form action="/create" method="POST">
                <input class="block px-3 py-2 w-full rounded-md outline-none bg-zinc-600" type="text" name="title" placeholder="title goes here">
                <textarea class="block px-3 py-2 w-full rounded-md outline-none mt-2 resize-none bg-zinc-600" name="details" placeholder="write your task details here"></textarea>
                <input class="mt-2 bg-blue-500 text-white px-4 py-1 rounded cursor-pointer" type="submit" value="create task">
            </form>
         </div>
        <div class="tasks flex flex-wrap p-10 gap-5">
            <% if(tasks.length === 0) { %>
                <h1 class="text-zinc-700">no task yet</h1>
            <% } else { %>
                <% tasks.forEach(task => { %>
                    <div class="w-72 px-3 py-4 bg-zinc-800 rounded-md">
                        <h1 class="text-white text-3xl tracking-tighter"><%= task.title %></h1>
                        <a class="text-blue-500 inline-block mt-3" href="/task/<%= task.filename %>">Read more</a>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>
    
</body>
</html>